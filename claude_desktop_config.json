  "mcpServers": {
    "my-custom-server": {
      "command": "/path_to_project/my-mcp-server/.venv/bin/python",
      "args": [
        "/path_to_project/my-mcp-server/server.py"
        ]
      },
      "my-http-server": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "http://127.0.0.1:8000/mcp",
        "--allow-http"
        ]
      }
  }

